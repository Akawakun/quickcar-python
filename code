print("===== QuickCar =====")

print("1. รถเก๋ง - 500 บาท/วัน")
print("2. รถกระบะ - 700 บาท/วัน")
print("3. รถตู้ - 1,000 บาท/วัน")

car = int(input("เลือกรถ: "))
days = int(input("จำนวนวันที่เช่า: "))

if car == 1:
    car_name = "รถเก๋ง"
    price = 500
elif car == 2:
    car_name = "รถกระบะ"
    price = 700
elif car == 3:
    car_name = "รถตู้"
    price = 1000
else:
    print("ไม่มีรถประเภทนี้")
    exit()

total = price * days

print("\n===== ข้อมูลการจอง =====")
print("รถที่เลือก:", car_name)
print("จำนวนวัน:", days)
print("ราคารวม:", total, "บาท")
